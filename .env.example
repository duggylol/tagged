# ---------------------------------------------------------------------------
# Tagged — environment
# Copy to apps/web/.env.local and fill in. Never commit the filled version.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# Project settings -> API. The publishable/anon key is safe in the browser;
# the secret/service-role key is server-only and must never be prefixed
# with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI providers ----------------------------------------------------------
# Gemini is the default for both vision extraction and listing copy.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Set to route listing copy through Claude instead (paid tier).
ANTHROPIC_API_KEY=

# Which provider handles which job. Values: gemini | anthropic
AI_VISION_PROVIDER=gemini
AI_COPY_PROVIDER=gemini

# Model overrides (optional — sensible defaults ship in packages/ai)
AI_VISION_MODEL=gemini-2.5-flash-lite
AI_COPY_MODEL=gemini-2.5-flash-lite
AI_PREMIUM_COPY_MODEL=claude-haiku-4-5

# Hard ceiling on AI spend per user per calendar month, in USD.
AI_MONTHLY_BUDGET_USD=2.00

# --- App -------------------------------------------------------------------
# Public origin. Used to build the phone-pairing QR link, so it must be
# reachable from your phone. In local dev use your LAN IP, e.g.
# http://192.168.1.20:3000 — "localhost" will not resolve on the phone.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# When building for Capacitor the app is a static bundle with no server, so
# it must call a deployed API. Leave blank for the web build.
NEXT_PUBLIC_API_BASE=

# --- Marketplaces (optional until you reach Phase 2) -----------------------
# https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
EBAY_ENV=sandbox

# https://www.etsy.com/developers/your-apps
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_REDIRECT_URI=

# Shared secret the browser extension uses to authenticate to /api/extension/*
EXTENSION_SHARED_SECRET=

# --- Scheduled jobs --------------------------------------------------------
# Protects /api/cron/detect-sales. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
